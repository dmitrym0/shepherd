{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "shepherd",
  "title": "Shepherd",
  "description": "Jump to the terminal of a shepherd-supervised agent",
  "icon": "icon.png",
  "author": "dmitrym",
  "license": "MIT",
  "commands": [
    {
      "name": "focus-agent",
      "title": "Focus Agent",
      "description": "List agents and focus the selected one's terminal",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "focusScript",
      "type": "textfield",
      "required": false,
      "title": "focus-agent.sh path",
      "default": "~/workspace/shepherd/tools/focus-agent.sh",
      "description": "Path to shepherd's focus-agent.sh"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.85.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist"
  }
}
